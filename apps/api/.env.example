# Copy to .env and fill in
NODE_ENV=development
PORT=4000

# MongoDB Atlas (free M0 cluster supports Vector Search)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=deskmate

# Redis for the ingestion queue. Upstash: console.upstash.com > your database > TCP / ioredis URL
REDIS_URL=rediss://default:PASSWORD@your-db.upstash.io:6379
# Optional: separates this setup's jobs from another one using the same Redis (the E2E tests use "e2e")
# QUEUE_PREFIX=bull

# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Signs login sessions. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional
CHAT_MODEL=gemini-flash-lite-latest
# Model that grades answers in npm run eval (defaults to CHAT_MODEL)
# EVAL_JUDGE_MODEL=
MIN_RELEVANCE=0.7
# Proxies in front of the API (for the real client IP in rate limits). 0 locally, usually 1 on Render/Railway.
TRUST_PROXY_HOPS=0
# Public address of this API, used in the widget snippet. Your deployed URL in production.
PUBLIC_URL=http://localhost:4000
