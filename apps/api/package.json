{
  "name": "@deskmate/api",
  "version": "0.1.0",
  "private": true,
  "description": "Deskmate API: ingestion, retrieval and chat",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "dev:worker": "tsx watch --import ./src/instrument.ts src/worker.ts",
    "start": "tsx --import ./src/instrument.ts src/index.ts",
    "start:worker": "tsx --import ./src/instrument.ts src/worker.ts",
    "db:setup": "tsx scripts/create-indexes.ts",
    "typecheck": "tsc",
    "eval": "tsx scripts/eval.ts",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "e2e:prepare": "tsx scripts/create-indexes.ts && tsx scripts/e2e-reset.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google": "4.0.95",
    "@deskmate/shared": "^0.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sentry/node": "11.8.0",
    "ai": "7.0.140",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0",
    "socket.io": "4.8.4",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
