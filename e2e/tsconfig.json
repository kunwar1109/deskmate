{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // Playwright compiles the tests itself and resolves extensionless imports, like a bundler.
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
